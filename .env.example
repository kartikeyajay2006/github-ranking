# GitHub token used for all API reads (public data only; no scopes required).
# Create one at https://github.com/settings/personal-access-tokens
# If unset, the server falls back to `gh auth token` from the GitHub CLI.
GITHUB_TOKEN=

# Optional: where the SQLite database lives (default: ./data/ranking.db)
DATABASE_PATH=

# Optional: how long a stored analysis counts as fresh, in hours (default: 12)
ANALYSIS_TTL_HOURS=12

# Required for a public instance. The username defaults to `admin`.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Optional: database snapshot location and retention.
BACKUP_DIR=
BACKUP_INTERVAL_HOURS=1
BACKUP_KEEP=24
BACKUP_KEEP_DAYS=14
# Optional off-machine copy command. It receives the snapshot path as its first argument.
BACKUP_COMMAND=

# Optional: enables assisted extraction for free-form documents.
ANTHROPIC_API_KEY=
